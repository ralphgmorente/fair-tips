# Supabase project the app authenticates against.
# Local stack: run `supabase start` and use the values it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Used by `npm run seed:user` to create accounts.
# NEVER prefix this with NEXT_PUBLIC_ — that would ship it to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Defaults for `npm run seed:user`. Supabase Auth rejects passwords under 6 characters.
SEED_ADMIN_EMAIL=mark@vibecode.review
SEED_ADMIN_PASSWORD=123456
SEED_ADMIN_NAME=ShiftFlow Manager
SEED_ADMIN_ROLE=admin
